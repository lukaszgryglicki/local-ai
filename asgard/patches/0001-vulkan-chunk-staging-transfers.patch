+// asgard patch (2026-09-12): on the NVIDIA FreeBSD driver (595.99.02, Quadro RTX 5000) a single host-visible allocation
+// of >= 256 MiB fails with ErrorOutOfDeviceMemory depending on the process' live pinned allocations: sizes in windows just
+// above powers of two ([256,265), [512,522), [1024,1035) MiB, ...) fail or succeed depending on the allocation layout,
+// sizes < 256 MiB always work. The sync staging buffer is sized to the largest single transfer, so a context-checkpoint
+// read-back of a >= 128K-token f16 KV slice (2 KiB/token) aborted llama-server. Large transfers now go through the
+// staging buffer in chunks (default 64 MiB, GGML_VK_STAGING_CHUNK_MB overrides; e.g. 100000 = off).
+static size_t ggml_vk_staging_chunk() {
+    static size_t chunk = 0;
+    if (chunk == 0) {
+        const char * env = getenv("GGML_VK_STAGING_CHUNK_MB");
+        chunk = (env && atoi(env) > 0 ? (size_t) atoi(env) : 64) * 1024 * 1024;
+    }
+    return chunk;
+}
+
 static void ggml_vk_buffer_read(vk_buffer& src, size_t offset, void * dst, size_t size) {
     VK_LOG_DEBUG("ggml_vk_buffer_read(" << src->buffer << ", " << offset << ", " << size << ")");
-    ggml_vk_buffer_read_2d(src, offset, dst, size, size, size, 1);
+    const size_t chunk = ggml_vk_staging_chunk();
+    for (size_t done = 0; done < size; done += chunk) {
+        const size_t n = std::min(chunk, size - done);
+        ggml_vk_buffer_read_2d(src, offset + done, (uint8_t *) dst + done, n, n, n, 1);
+    }
 }
 
