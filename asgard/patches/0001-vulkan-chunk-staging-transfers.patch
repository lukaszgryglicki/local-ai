+// asgard patch (2026-09-12): the NVIDIA FreeBSD driver (595.99.02, Quadro RTX 5000) refuses any single host-visible
+// allocation >= 256 MiB (255 MiB ok, 256 MiB -> ErrorOutOfDeviceMemory; the total is unlimited). The sync staging
+// buffer is sized to the largest single transfer, so a context-checkpoint read-back of a >= 128K-token f16 KV slice
+// (2 KiB/token) aborted llama-server. Large transfers now go through the staging buffer in chunks
+// (default 64 MiB, GGML_VK_STAGING_CHUNK_MB overrides).
+static size_t ggml_vk_staging_chunk() {
+    static size_t chunk = 0;
+    if (chunk == 0) {
+        const char * env = getenv("GGML_VK_STAGING_CHUNK_MB");
+        chunk = (env && atoi(env) > 0 ? (size_t) atoi(env) : 64) * 1024 * 1024;
+    }
+    return chunk;
+}
